{
  "name": "@tangent-cc-lib/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "build": "nx build tangent-cc-lib",
    "test": "nx test tangent-cc-lib",
    "lint": "nx lint tangent-cc-lib",
    "build-and-publish": "npm run build && cd tangent-cc-lib/dist && npm publish --access public"
  },
  "private": true,
  "packageManager": "yarn@4.18.1",
  "dependencies": {
    "eventemitter2": "^6.4.9",
    "rxjs": "^7.8.0",
    "semver": "^7.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nx/eslint": "22.7.12",
    "@nx/eslint-plugin": "22.7.12",
    "@nx/js": "22.7.12",
    "@nx/vitest": "22.7.12",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.8",
    "@swc/helpers": "~0.5.18",
    "@types/node": "20.19.9",
    "@types/semver": "^7.7.1",
    "@types/w3c-web-serial": "^1.0.8",
    "@vitest/coverage-v8": "~4.1.12",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "jsonc-eslint-parser": "^2.1.0",
    "nx": "22.7.12",
    "prettier": "~3.6.2",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "verdaccio": "^6.11.3",
    "vite": "^8.0.0",
    "vitest": "~4.1.12"
  },
  "workspaces": [
    "packages/*",
    "tangent-cc-lib"
  ],
  "nx": {
    "includedScripts": [],
    "targets": {
      "local-registry": {
        "executor": "@nx/js:verdaccio",
        "options": {
          "port": 4873,
          "config": ".verdaccio/config.yml",
          "storage": "tmp/local-registry/storage"
        }
      }
    }
  },
  "resolutions": {
    "nx/axios": "^1.21.1",
    "nx/follow-redirects": "^1.16.3",
    "nx/smol-toml": "^1.9.1",
    "nx/brace-expansion": "^5.1.0",
    "nx/form-data": "^4.0.6",
    "nx/tmp": "^0.2.6",
    "nx/minimatch": "^11.0.1",
    "@nx/devkit/minimatch": "^11.0.1",
    "@typescript-eslint/typescript-estree/minimatch": "^11.0.1",
    "@verdaccio/core/minimatch": "^11.0.1"
  }
}
